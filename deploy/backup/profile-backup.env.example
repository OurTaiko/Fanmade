# Root-only override; AWS credentials are read from /etc/ourtaiko-private/aws.env.
# The database lives in the shared ourtaiko-postgres instance.
BACKUP_DATABASE=ourtaiko_profile
BACKUP_POSTGRES_CONTAINER=ourtaiko-postgres
BACKUP_POSTGRES_USER=postgres
BACKUP_DIRECTORY=/var/backups/ourtaiko-profile/daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=true
BACKUP_S3_PREFIX=profile/backups/postgresql
AWS_REGION=ap-northeast-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
