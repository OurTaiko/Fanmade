# Root-only override; AWS credentials are read from /etc/ourtaiko-private/aws.env.
# The database lives in the shared ourtaiko-postgres instance (moved from sakura 2026-10-23).
BACKUP_DATABASE=ourtaiko_database
BACKUP_POSTGRES_CONTAINER=ourtaiko-postgres
BACKUP_POSTGRES_USER=postgres
BACKUP_DIRECTORY=/var/backups/ourtaiko-database/daily
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=true
BACKUP_S3_PREFIX=database/backups/postgresql
AWS_REGION=ap-northeast-1
S3_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
